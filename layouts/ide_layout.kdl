layout {

    pane split_direction="vertical" {
        filepicker size=40 name="picker"
        pane split_direction="horizontal" {
            editor size="75%"
            pane name="shell"
        }
    }
    pane size=2 borderless=true {
        plugin location="zellij:status-bar"
    }        
   
    

    // Collapse and expand the picker.
    //
    // Zellij has no "hide this pane" action, and a pane declared with an
    // explicit size is fixed: `zellij action resize` on the picker returns 0 and
    // moves nothing. Swap layouts are the supported way to restate the same
    // panes at different sizes, so the collapsed sidebar is a layout rather than
    // a resize. Alt+] (NextSwapLayout) collapses, Alt+[ (PreviousSwapLayout)
    // brings it back, and zellij names the active one in the status bar, so the
    // state is always visible.
    //
    // Listed before "compact" so the first Alt+] is the collapse and the second
    // takes the shell with it. A swap layout rehouses the panes a tab already
    // has and cannot add or drop any, which is why the picker goes to size=2
    // rather than away: it is the narrowest zellij will draw while leaving an
    // edge to aim at. yazi keeps running at that width and redraws when it is
    // expanded again.
    swap_tiled_layout name="collapsed" {
        tab exact_panes=4 {
            pane split_direction="vertical" {
                filepicker size=2 name="picker"
                pane split_direction="horizontal" {
                    editor size="75%"
                    pane name="shell"
                }
            }
            pane size=2 borderless=true {
                plugin location="zellij:status-bar"
            }
        }

        tab min_panes=5 {
            pane split_direction="vertical" {
                filepicker size=2 name="picker"
                pane split_direction="horizontal" {
                    editor size="50%"
                    pane split_direction="vertical" {
                        pane
                        pane
                    }
                }
            }
            pane size=2 borderless=true {
                plugin location="zellij:status-bar"
            }
        }
    }

    // Second stop on the same cycle: the picker stays collapsed and the shell
    // joins it, leaving the editor everything but two columns and two rows.
    //
    // This variant used to restate the base layout exactly, so Alt+] landed on a
    // state that looked like nothing had happened. Collapsing the shell as well
    // makes the cycle a progression; see "no-shell" below for where it ends.
    swap_tiled_layout name="compact" {
        tab exact_panes=4 {
            pane split_direction="vertical" {
                filepicker size=2 name="picker"
                pane split_direction="horizontal" {
                    editor
                    pane name="shell" size=2
                }
            }
            pane size=2 borderless=true {
                plugin location="zellij:status-bar"
            }
        }

        tab min_panes=5 {
            pane split_direction="vertical" {
                filepicker size=40 name="picker"
                pane split_direction="horizontal" {
                    editor size="50%"
                    pane split_direction="vertical" {
                        pane
                        pane
                    }
                }
            }
            pane size=2 borderless=true {
                plugin location="zellij:status-bar"
            }
        }
    }

    // Last stop: the picker is back and only the shell stays collapsed, for
    // reading around the tree without a terminal underneath. A fourth Alt+]
    // returns to base, so the full cycle is
    //
    //   base -> picker away -> picker and shell away -> shell away -> base
    //
    // exact_panes=4 only. With a fifth pane open there is no single obvious
    // thing "collapse the shell" should mean, so this stop drops out of the
    // cycle rather than guessing at an arrangement.
    swap_tiled_layout name="no-shell" {
        tab exact_panes=4 {
            pane split_direction="vertical" {
                filepicker size=40 name="picker"
                pane split_direction="horizontal" {
                    editor
                    pane name="shell" size=2
                }
            }
            pane size=2 borderless=true {
                plugin location="zellij:status-bar"
            }
        }
    }

    // TEMPLATES
    pane_template name="filepicker" {
        command "zide-pick"
    }

    pane_template name="editor" {
        command "$EDITOR"
    }

    pane_template name="zide_rename" command="zide-rename" close_on_exit=true

    new_tab_template {
        pane
        pane size=2 borderless=true {
            plugin location="zellij:status-bar"
        }       
    }
}
